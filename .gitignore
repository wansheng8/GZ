# 构建产物
build/

# Python 缓存
__pycache__/
*.pyc

# 虚拟环境
.venv/
venv/

# 日志
*.log

# 构建期本地解析缓存（key = 源内容 sha256 + 算法版本，无需提交，clone 后首次构建自动重建）
.cache/
# 审计用大文件（CI 每次构建重新生成，订阅者不需要，不入库）
dist/relation_graph.json
dist/provenance.json
# 本地/连续构建的逐条规则差异（依赖上一批指纹，CI 全新 checkout 无此文件）
dist/build_diff.txt
# 规则过期跟踪报告（需 --history，CI 不生成）
dist/maintenance_report.json
